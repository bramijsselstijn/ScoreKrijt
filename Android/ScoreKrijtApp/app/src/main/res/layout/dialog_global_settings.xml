<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speler 1 Naam"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_p1_name"
            android:maxLength="14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Speler 1 TMC"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_p1_tmc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Speler 2 Naam"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_p2_name"
            android:maxLength="14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Speler 2 TMC"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_p2_tmc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kleur Starter"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_start_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wit" />

            <RadioButton
                android:id="@+id/rb_color_yellow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geel" />
        </RadioGroup>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_temp_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tijdelijk wedstrijd overzicht" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/help_menu_label"
            app:icon="@android:drawable/ic_menu_help" />

        <LinearLayout
            android:id="@+id/sk_box_sync_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_sk_box_settings_dialog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Instellingen\nSK-Box"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_sync_to_sk_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Synchroniseer\nnaar SK-Box"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_sync_from_sk_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Synchroniseer\nvan SK-Box"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>



