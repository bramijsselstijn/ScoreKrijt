<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BepalenAanvangWedstrijd">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/SamenvattingTitle"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/summaryLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/gray_background"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle"
        tools:layout_editor_absoluteX="16dp">

        <TextView
            android:id="@+id/tvSummaryP1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speler 1: Naam (0 TMC)"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSummaryP2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speler 2: Naam (0 TMC)"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSummaryGameType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wedstrijdvorm: Vaste beurten (30)"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWhoStartsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/WieBegintTitle"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/summaryLayout"
        app:layout_constraintTop_toBottomOf="@id/summaryLayout" />

    <RadioGroup
        android:id="@+id/rgWhoStarts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvWhoStartsTitle">

        <RadioButton
            android:id="@+id/rbStarterP1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Speler 1" />

        <RadioButton
            android:id="@+id/rbStarterP2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Speler 2" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvColorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/KleurTitle"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/summaryLayout"
        app:layout_constraintTop_toBottomOf="@id/rgWhoStarts" />

    <RadioGroup
        android:id="@+id/rgColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvColorTitle">

        <RadioButton
            android:id="@+id/rbColorWhite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/KleurWit" />

        <RadioButton
            android:id="@+id/rbColorYellow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/KleurGeel" />
    </RadioGroup>

    <Button
        android:id="@+id/btnResumeMatchBepalen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/ResumeGameKnop"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnStartMatch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnStartMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/StartWedstrijdKnop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>