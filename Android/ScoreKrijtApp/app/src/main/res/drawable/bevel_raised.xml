<?xml version="1.0" encoding="utf-8"?>
<!-- Opgehoogde rand voor knoppen die strak tegen elkaar liggen (waar een schaduw niet zichtbaar is):
     lichte rand boven en links, donkere rand onder en rechts. Ingedrukt is het omgekeerd. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:gravity="top" android:height="12dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#88000000" android:endColor="#00000000" />
                </shape>
            </item>
            <item android:gravity="left" android:width="12dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#88000000" android:endColor="#00000000" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="10dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#66FFFFFF" />
                </shape>
            </item>
            <item android:gravity="right" android:width="10dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:endColor="#66FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="top" android:height="12dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#99FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item android:gravity="left" android:width="12dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#99FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="14dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00000000" android:endColor="#99000000" />
                </shape>
            </item>
            <item android:gravity="right" android:width="14dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00000000" android:endColor="#99000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
