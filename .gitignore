# Standaard wordt alles genegeerd; alleen wat hieronder is vrijgegeven komt in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/PRIVACY.md
!/CHANGELOG.md
!/ROADMAP.md
!/Android/
!/Docs/
!/Phyton/

# --- Android: de broncode en de APK-bestanden blijven lokaal (Google Drive); er staat niets van de Android-app op GitHub ---
/Android/*

# --- Python (SK-Box): alleen de huidige versie ---
/Phyton/*
!/Phyton/V2.8.7/
!/Phyton/SK-Box_scripts/
# Door de SK-Box zelf gemaakt tijdens het draaien
scorekrijt-autostart.log
scorekrijt.lock
scorekrijt.ready
__pycache__/
*.pyc
build/
dist/
matches/

# --- SK-Box behuizing: alleen de 3D-printbestanden (geen SolidWorks-bestanden) ---
!/SK-Box/
/SK-Box/*
!/SK-Box/Base-Part.3mf
!/SK-Box/Base-Part.STL
!/SK-Box/Part3^Assem1.STL

# --- Handleidingen: alleen pdf's; .docx en de .ps1-bouwscripts blijven lokaal ---
*.ps1
*.docx
/Docs/.skbox_*/
/Docs/rendered_handleiding/
/Docs/*.pptx
/Docs/*.gdoc
/Docs/*.gsheet
/Docs/Fonts.docx
# Van de logomap is alleen het logo nodig dat de bouwscripts gebruiken
/Docs/Logos/*
!/Docs/Logos/ScoreKrijt Logo.png

# --- Overig ---
~$*
desktop.ini
*.apk
*.keystore
*.jks
/Docs/Play-Store-checklist.md
